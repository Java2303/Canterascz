---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Carousel from '../components/Carousel.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { santaCruzPhotos, virtues } from '../data/site';

const pillars = [
  { icon: 'Users', title: 'Fraternidad', text: 'Más que una organización, somos una familia unida por lazos de hermandad que perduran para toda la vida.' },
  { icon: 'Award', title: 'Liderazgo', text: 'Desarrollamos habilidades de gestión, oratoria y toma de decisiones en un entorno práctico y seguro.' },
  { icon: 'HeartHandshake', title: 'Servicio', text: 'Impactamos positivamente en nuestra comunidad a través de proyectos de ayuda social y voluntariado.' },
] as const;
const facts = [
  { value: '20+', label: 'países con presencia DeMolay' },
  { value: '1M+', label: 'jóvenes impactados históricamente' },
  { value: '7', label: 'virtudes cardinales que nos guían' },
];
---
<Base title="Inicio" image="img/reunion.jpg">
  <!-- Portada -->
  <section class="relative isolate flex min-h-[92dvh] items-end overflow-hidden text-white">
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <img src="img/reunion.jpg" alt="Jóvenes de Cantera en una reunión solemne" class="absolute inset-0 size-full scale-110 object-cover" data-parallax />
      <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/55 to-brand-700/30"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink-950/80 via-transparent to-transparent"></div>
    </div>

    <div class="mx-auto w-full max-w-7xl px-5 pb-28 pt-40 md:px-8 md:pb-36">
      <p data-reveal class="eyebrow mb-6 inline-flex items-center gap-2.5 text-white/85">
        <span class="size-1.5 rounded-full bg-brand-500"></span> DeMolay International · Bolivia
      </p>
      <h1 data-reveal data-delay="80" class="type-hero max-w-4xl">
        <span class="mb-4 block text-[clamp(1.25rem,0.95rem+1.3vw,2rem)] font-semibold leading-[1.2] tracking-[-0.012em] text-white/80">Bienvenidos a</span><span class="bg-gradient-to-r from-brand-300 to-brand-500 bg-clip-text text-transparent">Capítulo Cantera</span> <span class="whitespace-nowrap font-bold text-white">#75024</span>
      </h1>
      <p data-reveal data-delay="160" class="type-lede mt-7 max-w-xl text-white/85">
        Formando líderes, forjando hermanos. Una fraternidad dedicada a construir el carácter de los jóvenes de hoy.
      </p>
      <div data-reveal data-delay="240" class="mt-10 flex flex-wrap items-center gap-4">
        <a href="quienes-somos.html" class="btn btn-light" data-press>
          Descubre nuestra historia
          <Icon name="ArrowRight" class="btn-arrow size-4" />
        </a>
        <a href="actividades.html" class="btn material-light text-white" data-press>
          Ver actividades
        </a>
        <a href="#datos" aria-label="Ir al contenido" class="material-light group ml-auto hidden size-12 place-items-center rounded-full text-white transition-colors duration-150 md:grid" data-press>
          <Icon name="ArrowDown" class="btn-arrow-down size-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Datos clave -->
  <section id="datos" class="relative z-10 -mt-12 px-5 md:-mt-16 md:px-8">
    <dl class="mx-auto grid max-w-7xl grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
      {facts.map((f, i) => (
        <div data-reveal data-delay={i * 80} class="card flex flex-col-reverse p-8 shadow-(--shadow-float) md:p-10">
          <dt class="eyebrow mt-4 border-t border-stone-200 pt-4 text-ink-600">{f.label}</dt>
          <dd class="type-stat text-brand-700">{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Pilares -->
  <section class="mx-auto max-w-7xl px-5 py-24 md:px-8 md:py-32">
    <SectionHeader eyebrow="Por qué Cantera" title="¿Por qué ser parte de Cantera?" text="Una escuela diseñada para el crecimiento personal y la excelencia fraternal." />
    <div class="mt-12 grid gap-6 md:mt-16 md:grid-cols-3">
      {pillars.map((p, i) => (
        <article data-reveal data-delay={i * 80} class="card p-8 md:p-10">
          <div class="mb-8 grid size-14 place-items-center rounded-2xl bg-brand-50 text-brand-700">
            <Icon name={p.icon} class="size-7" />
          </div>
          <h3 class="type-title mb-3">{p.title}</h3>
          <p class="text-ink-600">{p.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Qué es DeMolay -->
  <section class="bg-ink-950 py-24 text-white md:py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-16 px-5 md:grid-cols-2 md:px-8">
      <div>
        <SectionHeader eyebrow="La Orden" title="¿Qué es DeMolay?" tone="dark" />
        <div class="type-lede mt-8 space-y-5 text-white/75">
          <p data-reveal>La Orden DeMolay es la organización fraternal de carácter iniciático para jóvenes varones entre 12 y 21 años más grande del mundo. Fundada hace más de un siglo, su misión global es formar ciudadanos ejemplares y líderes íntegros.</p>
          <p data-reveal data-delay="80">Patrocinada por la Masonería, DeMolay enseña virtudes cívicas y morales a través de rituales simbólicos y una estructura de autogestión liderada por los propios jóvenes.</p>
        </div>
        <ul class="mt-10 space-y-4">
          {['Presencia en más de 20 países', 'Más de 1 millón de jóvenes impactados históricamente'].map((t, i) => (
            <li data-reveal data-delay={160 + i * 80} class="flex items-center gap-4 font-semibold">
              <Icon name="CheckCircle2" class="size-6 shrink-0 text-brand-500" /> {t}
            </li>
          ))}
        </ul>
      </div>
      <div data-reveal class="relative">
        <div class="absolute -right-10 -top-10 size-72 rounded-full bg-brand-500/25 blur-3xl"></div>
        <img src="img/demolay-bolivia-2.jpg" alt="Reunión de DeMolay" loading="lazy" class="relative aspect-[4/5] w-full rounded-4xl object-cover shadow-2xl ring-1 ring-white/10" />
      </div>
    </div>
  </section>

  <!-- Virtudes -->
  <section class="mx-auto max-w-7xl px-5 py-24 md:px-8 md:py-32">
    <SectionHeader eyebrow="Nuestros pilares" title="7 Virtudes Cardinales" align="center" />
    <ul class="mt-12 grid grid-cols-2 gap-4 md:mt-16 md:grid-cols-4 lg:grid-cols-7">
      {virtues.map((v, i) => (
        <li data-reveal data-delay={i * 60} class="card flex flex-col items-center p-6 text-center">
          <span class="mb-5 grid size-16 place-items-center rounded-full bg-brand-50 text-brand-700">
            <Icon name={v.icon} class="size-7" />
          </span>
          <span class="font-label text-[0.8125rem] font-bold uppercase leading-snug tracking-[0.06em]">{v.name}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- DeMolay en Santa Cruz -->
  <section class="bg-stone-100 py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <SectionHeader eyebrow="Santa Cruz" title="DeMolay en Santa Cruz" text="Momentos que definen nuestra historia local." />
    </div>
    <div class="mx-auto mt-12 max-w-7xl px-5 md:mt-16 md:px-8">
      <Carousel label="DeMolay en Santa Cruz" trackClass="gap-5 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible" hideControlsOnDesktop>
        {santaCruzPhotos.map((p) => (
          <figure class="group relative aspect-[4/5] w-[84vw] max-w-[440px] shrink-0 cursor-zoom-in snap-start overflow-hidden rounded-4xl shadow-(--shadow-raised) md:w-auto md:max-w-none" data-lightbox-src={p.src} data-lightbox-title={p.title}>
            <img src={p.src} alt={p.alt} loading="lazy" class="media-zoom size-full object-cover" />
            <figcaption class="type-headline pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink-950/90 to-transparent p-7 pt-16 text-white">{p.title}</figcaption>
          </figure>
        ))}
      </Carousel>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative isolate overflow-hidden bg-brand-700 py-24 text-white md:py-32">
    <Icon name="Shield" class="pointer-events-none absolute -right-24 top-1/2 -z-10 size-[30rem] -translate-y-1/2 text-white/10" strokeWidth={0.6} />
    <div class="mx-auto max-w-4xl px-5 text-center md:px-8">
      <h2 data-reveal class="type-section font-extrabold">¿Estás listo para unirte a DeMolay?</h2>
      <p data-reveal data-delay="80" class="type-lede mx-auto mt-6 max-w-2xl text-white/90">
        Únete a una red de jóvenes comprometidos con el liderazgo y la excelencia. El camino hacia la mejor versión de ti mismo comienza aquí.
      </p>
      <div data-reveal data-delay="160" class="mt-10">
        <a href="contacto.html" class="btn btn-light btn-lg" data-press>
          Solicitar Información <Icon name="ArrowRight" class="btn-arrow size-5" />
        </a>
      </div>
    </div>
  </section>
</Base>
