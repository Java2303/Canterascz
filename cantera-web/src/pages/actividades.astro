---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';

const pillars = [
  { icon: 'HandHeart', title: 'Filantropía', text: 'Devolvemos a la comunidad el apoyo recibido, organizando colectas y proyectos de ayuda social que marcan la diferencia.', img: 'img/filantropia.jpg', alt: 'Jornadas de filantropía' },
  { icon: 'Trophy', title: 'Deportes', text: 'Fomentamos el espíritu competitivo, la disciplina y el trabajo en equipo en la cancha, donde la hermandad también juega.', img: 'img/deporte.jpeg', alt: 'Eventos deportivos y recreativos' },
  { icon: 'GraduationCap', title: 'Capacitación', text: 'Preparamos a nuestros miembros para el futuro con talleres de oratoria, liderazgo y desarrollo de habilidades profesionales.', img: 'img/taller.jpeg', alt: 'Capacitación en liderazgo y desarrollo personal' },
  { icon: 'Users', title: 'Fraternidad', text: 'Nuestras reuniones y convivencias son el corazón del capítulo, donde se fortalecen los lazos que nos definen como familia.', img: 'img/ultimo-campeonato-1.jpg', alt: 'Reuniones fraternales' },
] as const;
---
<Base title="Actividades" description="Pilares de acción del Capítulo Cantera #75024: filantropía, deportes, capacitación y fraternidad.">
  <PageHero eyebrow="Actividades" title="La hermandad en acción" text="Más allá de las palabras: descubre cómo transformamos nuestros valores en un impacto real." image="img/contacto.jpg" alt="Jóvenes del capítulo en un evento de fraternidad" />

  <section class="mx-auto max-w-7xl px-5 py-24 md:px-8 md:py-32">
    <SectionHeader eyebrow="Pilares de nuestra acción" title="Cuatro áreas que definen nuestro compromiso" text="Desarrollo y la forma en que vivimos los principios DeMolay." />
    <div class="mt-12 grid gap-6 md:mt-16 md:grid-cols-2">
      {pillars.map((p, i) => (
        <article data-reveal data-delay={i * 80} class="group relative isolate flex min-h-[30rem] cursor-zoom-in overflow-hidden rounded-4xl shadow-(--shadow-raised) transition-shadow duration-300 hover:shadow-(--shadow-float)" data-press="0.985" data-lightbox-src={p.img} data-lightbox-title={p.alt}>
          <img src={p.img} alt={p.alt} loading="lazy" class="media-zoom absolute inset-0 -z-10 size-full object-cover" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-ink-950/45 to-transparent"></div>
          <div class="flex w-full flex-col justify-end gap-4 p-8 text-white md:p-10">
            <span class="icon-tile material-light grid size-12 place-items-center rounded-2xl"><Icon name={p.icon} class="size-6" /></span>
            <h3 class="type-title">{p.title}</h3>
            <p class="max-w-md font-medium text-white/85">{p.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="px-5 pb-24 md:px-8 md:pb-32">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 rounded-4xl bg-ink-950 p-8 text-white md:flex-row md:items-center md:p-16">
      <div>
        <h2 data-reveal class="type-section font-extrabold">¿Listo para ser parte de la acción?</h2>
        <p data-reveal data-delay="80" class="type-lede mt-4 max-w-xl text-white/75">Si te identificas con nuestros pilares y quieres crecer junto a nosotros, este es tu lugar.</p>
      </div>
      <div data-reveal data-delay="160" class="flex shrink-0 flex-wrap gap-4">
        <a href="contacto.html" class="btn btn-primary" data-press>Únete Ahora</a>
        <a href="https://wa.link/hnfulp" target="_blank" rel="noopener" class="btn btn-ghost" data-press>Contactar</a>
      </div>
    </div>
  </section>
</Base>
