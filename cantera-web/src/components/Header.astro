---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';

const current = Astro.url.pathname.split('/').pop() || 'index.html';
const isActive = (href: string) => (href === 'index.html' ? current === '' || current === 'index.html' : current === href);
---
<header class="glass-header fixed inset-x-0 top-0 z-50 text-white" data-site-header>
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 md:px-8 xl:gap-8" aria-label="Principal">
    <a href="index.html" class="flex shrink-0 items-center gap-3 rounded-xl">
      <img src="img/logo.png" alt="Logo Capítulo Cantera" width="44" height="44" class="size-11 object-contain" />
      <span class="whitespace-nowrap font-display text-[1.0625rem] font-bold leading-[1.2] tracking-[-0.01em] xl:text-lg">
        Capítulo Cantera<br /><span class="font-semibold text-white/65">#75024</span>
      </span>
    </a>

    <ul id="main-menu" class="material-heavy absolute inset-x-3 top-full mt-2 hidden max-h-[calc(100dvh-6rem)] flex-col gap-1 overflow-y-auto rounded-3xl p-3 shadow-2xl ring-1 ring-white/10 xl:static xl:mt-0 xl:flex xl:max-h-none xl:flex-row xl:items-center xl:gap-1 xl:overflow-visible xl:rounded-none xl:bg-transparent xl:p-0 xl:shadow-none xl:ring-0 xl:backdrop-blur-none">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="nav-link block whitespace-nowrap rounded-full px-4 py-3 font-label text-[0.8125rem] font-semibold uppercase tracking-[0.1em] xl:px-3 xl:py-2 xl:text-[0.78rem] xl:tracking-[0.08em]"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a href="contacto.html" class="btn btn-sm btn-primary hidden sm:inline-flex" data-press>Unirse</a>
      <button
        type="button"
        class="material-light grid size-11 place-items-center rounded-full text-white transition-colors duration-150 xl:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="main-menu"
        data-menu-toggle
        data-press
      >
        <Icon name="Menu" class="menu-icon-open size-5" />
        <Icon name="X" class="menu-icon-close size-5" />
      </button>
    </div>
  </nav>
</header>
