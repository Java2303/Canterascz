---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';

const current = Astro.url.pathname.split('/').pop() || 'index.html';
const isActive = (href: string) => (href === 'index.html' ? current === '' || current === 'index.html' : current === href);
---
<header class="glass-header sticky top-0 z-50 text-white" data-site-header>
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 md:px-8 xl:gap-8">
    <a href="index.html" class="flex items-center gap-3 rounded-lg">
      <img src="img/logo.png" alt="Logo Capítulo Cantera" width="44" height="44" class="size-11 object-contain" />
      <span class="whitespace-nowrap font-display text-[1.05rem] font-bold leading-tight tracking-tight xl:text-lg">
        Capítulo Cantera<br /><span class="text-white/60">#75024</span>
      </span>
    </a>

    <ul id="main-menu" class="fixed inset-x-0 top-[68px] hidden max-h-[calc(100dvh-68px)] flex-col gap-1 overflow-y-auto border-b border-white/10 bg-ink-950/95 px-5 pb-6 pt-3 shadow-2xl backdrop-blur-xl xl:static xl:flex xl:max-h-none xl:flex-row xl:items-center xl:gap-1 xl:overflow-visible xl:border-0 xl:bg-transparent xl:p-0 xl:shadow-none xl:backdrop-blur-none">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'nav-link block whitespace-nowrap rounded-full px-3.5 py-2.5 font-label text-[13px] font-semibold uppercase tracking-[0.1em] xl:px-3 xl:text-[12.5px] xl:tracking-[0.09em] 2xl:px-4 2xl:text-sm 2xl:tracking-[0.14em] transition-colors duration-300 xl:py-2',
              isActive(item.href) ? 'text-brand-300 bg-white/5' : 'text-white/80 hover:bg-white/5 hover:text-white',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="contacto.html"
        class="sheen hidden rounded-full bg-brand-700 px-5 py-2.5 font-label text-xs font-bold uppercase tracking-[0.16em] text-white transition-all duration-300 hover:bg-brand-500 active:scale-95 sm:inline-flex"
      >
        Unirse
      </a>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full border border-white/10 text-white transition-colors hover:bg-white/10 xl:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="main-menu"
        data-menu-toggle
      >
        <Icon name="Menu" class="size-5" />
      </button>
    </div>
  </nav>
</header>
