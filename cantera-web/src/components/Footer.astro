---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-ink-950 text-white">
  <div class="pointer-events-none absolute -top-40 left-1/2 h-80 w-[60rem] -translate-x-1/2 rounded-full bg-brand-500/10 blur-3xl"></div>
  <div class="relative mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-3 md:px-8 md:py-20">
    <div class="flex flex-col gap-6">
      <div class="flex items-center gap-3">
        <img src="img/logo.png" alt="" width="40" height="40" class="size-10 object-contain" />
        <span class="type-headline">{site.name}</span>
      </div>
      <p class="max-w-xs text-[0.9375rem] leading-relaxed text-white/70">
        Forjando el futuro de Santa Cruz a través del liderazgo juvenil y los valores fraternales de la Orden DeMolay.
      </p>
      <div class="flex gap-3">
        <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="grid size-11 place-items-center rounded-full bg-white/8 text-white/80 ring-1 ring-white/10 transition-colors duration-150 hover:bg-brand-700 hover:text-white" data-press>
          <BrandIcon name="instagram" class="size-5" />
        </a>
        <a href={site.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp" class="grid size-11 place-items-center rounded-full bg-white/8 text-white/80 ring-1 ring-white/10 transition-colors duration-150 hover:bg-brand-700 hover:text-white" data-press>
          <BrandIcon name="whatsapp" class="size-5" />
        </a>
      </div>
    </div>

    <div>
      <h2 class="eyebrow mb-5 text-white/60">Navegación</h2>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-1">
        {nav.map((item) => (
          <li><a href={item.href} class="inline-block rounded-md py-1.5 text-[0.9375rem] text-white/80 transition-colors duration-150 hover:text-brand-300">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="eyebrow mb-5 text-white/60">Contacto</h2>
      <ul class="flex flex-col gap-4 text-[0.9375rem] text-white/80">
        <li class="flex items-start gap-3"><Icon name="MapPin" class="mt-1 size-4 shrink-0 text-brand-500" /> Santa Cruz de la Sierra, Bolivia</li>
        <li class="flex items-start gap-3"><Icon name="Mail" class="mt-1 size-4 shrink-0 text-brand-500" /> <a href={`mailto:${site.email}`} class="break-all rounded-md transition-colors duration-150 hover:text-brand-300">{site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="relative mx-auto max-w-7xl border-t border-white/10 px-5 py-6 text-center md:px-8 md:text-left">
    <p class="font-label text-xs tracking-[0.02em] text-white/60">© {year} {site.name}. Miembro de DeMolay Internacional.</p>
  </div>
</footer>
