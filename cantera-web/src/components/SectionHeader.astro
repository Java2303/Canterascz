---
// Encabezado de sección: etiqueta, título y bajada. tone="dark" sobre fondos oscuros (contraste AA)
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
}
const { eyebrow, title, text, align = 'left', tone = 'light' } = Astro.props;
const center = align === 'center';
const dark = tone === 'dark';
---
<div class:list={['max-w-3xl', center && 'mx-auto text-center']}>
  {eyebrow && <p data-reveal class:list={['eyebrow mb-4', dark ? 'text-brand-300' : 'text-brand-700']}>{eyebrow}</p>}
  <h2 data-reveal data-delay="60" class="type-section">{title}</h2>
  {text && <p data-reveal data-delay="140" class:list={['type-lede mt-5', dark ? 'text-white/70' : 'text-ink-600']}>{text}</p>}
</div>
