---
// Cabecera de página a pantalla completa con imagen, degradado y parallax
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  image: string;
  alt: string;
  position?: string;
}
const { eyebrow, title, text, image, alt, position = 'center' } = Astro.props;
---
<section class="relative isolate flex min-h-[70dvh] items-end overflow-hidden text-white">
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <img src={image} alt={alt} class="absolute inset-0 size-full scale-110 object-cover" style={`object-position: ${position}`} data-parallax />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/60 to-ink-950/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950/70 via-transparent to-transparent"></div>
  </div>
  <div class="mx-auto w-full max-w-7xl px-5 pb-20 pt-40 md:px-8 md:pb-28">
    <p data-reveal class="mb-5 font-label text-xs font-bold uppercase tracking-[0.22em] text-brand-300">{eyebrow}</p>
    <h1 data-reveal data-delay="80" class="max-w-4xl text-[clamp(2.7rem,7.5vw,5.5rem)] font-extrabold">{title}</h1>
    {text && <p data-reveal data-delay="170" class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 md:text-xl">{text}</p>}
  </div>
</section>
